# Pinned upstream sources. Sourced by scripts/*.sh and the release workflow.
#
# The QEMU tarball's signature was checked against the QEMU release key
# (Michael Roth, CEAC C9E1 5534 EBAB B82D 3FA0 3353 C9CE F108 B584) when the
# hash was pinned; the build itself only checks the hash.

QEMU_VERSION=10.2.4
QEMU_SHA256=821b545b92f165e57dddccac5077d76d4d436a226595b8813ad59306bbfd0746

GLIB_VERSION=2.88.4
GLIB_SHA256=25fd169f3b2f91fe2391ad297883ce0fcf30c69fc789ffd1c9672d1332b1c5a8

# Build-time Python tools, installed into a private venv.
MESON_VERSION=1.9.0
NINJA_VERSION=1.13.0

# Same floor as ArcBox itself.
MACOSX_DEPLOYMENT_TARGET=15.0
